{
  "version": 1,
  "environment": {
    "os": "windows|macos|linux",
    "shell": "powershell|zsh|bash",
    "is_wsl": false,
    "wsl_distro": null
  },
  "paths": {
    "home": "<resolved home>",
    "python": "<resolved python executable>",
    "commands": {}
  },
  "runtime_registry": {
    "templates_seeded": true,
    "template_version": 2,
    "template_source": "config/runtime-templates.json"
  },
  "probe_commands": [],
  "credentials": {
    "example": {
      "type": "file|keychain|env|command",
      "path": null,
      "service": null,
      "account": null,
      "env": null,
      "command": null
    }
  },
  "runtimes": {
    "<runtime-id>": {
      "display_name": "<human-readable name>",
      "enabled": true,
      "source": "template|user",
      "command_candidates": ["<command-or-path>"],
      "entry_candidates": ["~/<runtime-dir>/<entry-file>"],
      "skills_candidates": ["~/<runtime-dir>/skills"],
      "capabilities": ["agent", "review", "skills"],
      "skills_sync_mode": "per-skill-link|central-dir-link|none",
      "auto_sync_skills": false,
      "review": {
        "args": ["<headless-arg>"],
        "priority": 50
      },
      "executable": "<resolved executable after detection>",
      "entry_path": "<resolved entry after detection>",
      "skills_path": "<resolved skills path after detection>",
      "skills_layout": "<detected layout>"
    }
  },
  "skills": {
    "example": {
      "launcher": null,
      "state_dir": null,
      "output_dir": null,
      "db_path": null,
      "browser_type": null,
      "other_non_secret_machine_config": null
    }
  },
  "services": {},
  "search": {
    "contexts": {
      "<runtime-provider-or-model-context>": {
        "runtime": "<runtime-id>",
        "provider": "<provider-id>",
        "model": "<model name/pattern>",
        "hosting": "cloud|local|self-hosted|unknown",
        "lane": "cloud-native|local-managed",
        "endpoint": "<non-secret endpoint if useful>",
        "preferred_backends": ["<backend-id>"],
        "allow_cross_lane_fallback": false,
        "native_tools": {
          "<tool-id>": {
            "backend": "<backend-id>",
            "policy": "allow|disabled",
            "suppression": {
              "strategy": "runtime-config|tool-filter|plugin-toggle|profile-override|other",
              "config_locator": "<local non-secret locator>",
              "scope": "<profile|session|runtime>",
              "verified_absent": false,
              "requires_restart": true
            }
          }
        }
      }
    },
    "backends": {
      "<backend-id>": {
        "enabled": true,
        "lane": "local-managed",
        "roles": ["general", "fetch", "accurate", "precise", "repo", "code", "research", "fallback"],
        "kind": "mcp|cli|command",
        "priority": 100,
        "command": null,
        "config_path": null,
        "credential": null
      }
    }
  }
}
