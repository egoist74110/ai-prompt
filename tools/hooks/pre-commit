#!/bin/bash
# 中央提示词仓库 pre-commit（正典在 tools/hooks/pre-commit，用 tools/install-hooks.sh 安装）
# 1) 重建 capabilities/skills.md 自动索引 + 一致性校验
# 2) 禁止具体用户 home / 固定 WSL distro 等机器身份回流中央
# 3) 校验工作树与暂存快照的 skill 集合一致
# 4) 按本地 runtime registry 同步声明 auto_sync_skills=true 的运行时
#
# hook 是便利机制，不是不可绕过的完整性边界。最终体检入口是 tools/doctor.py。
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

PY=python3
command -v python3 >/dev/null 2>&1 || PY=python
command -v "$PY" >/dev/null 2>&1 || {
  echo "pre-commit: python/python3 不在 PATH，无法执行索引/同步，提交已中止。" >&2
  exit 1
}

# --- 1. 索引 ---
"$PY" "$ROOT/tools/gen-index.py" || {
  echo "pre-commit: 索引生成/校验失败，提交已中止。" >&2
  exit 1
}

# --- 2. portable central rules ---
"$PY" "$ROOT/tools/check_portability.py" || {
  echo "pre-commit: 检测到机器身份/绝对 home 回流中央，提交已中止。" >&2
  exit 1
}

# --- 3. 工作树 vs 暂存快照 ---
worktree_skills=$(ls -d skills/*/SKILL.md 2>/dev/null | sed 's|skills/\(.*\)/SKILL.md|\1|' | sort)
# 必须与上面 ls 一样只看第一层：git 默认 pathspec 的 * 会跨目录，
# 嵌套的 SKILL.md（如 skills/<name>/examples/*/SKILL.md）会误入暂存集合。
staged_skills=$(git ls-files --cached -- ':(glob)skills/*/SKILL.md' | sed 's|skills/\(.*\)/SKILL.md|\1|' | sort)
if [ "$worktree_skills" != "$staged_skills" ]; then
  echo "pre-commit: 工作树与暂存区的 skill 集合不一致，已中止。" >&2
  echo "  只在工作树、未暂存：" >&2
  comm -23 <(echo "$worktree_skills") <(echo "$staged_skills") | sed 's/^/    /' >&2
  echo "  只在暂存区、工作树已无：" >&2
  comm -13 <(echo "$worktree_skills") <(echo "$staged_skills") | sed 's/^/    /' >&2
  echo "  → 把对应 skills/<name>/ 一并 git add / git rm 后重试。" >&2
  exit 1
fi

# --- 4. runtime skills 同步（完全由 registry 数据决定，不认识任何 runtime 名字）---
if ! sync_out=$("$PY" "$ROOT/tools/sync_skills.py" --all --auto-only 2>&1); then
  echo "pre-commit: runtime skills 同步失败，提交已中止：" >&2
  echo "$sync_out" | sed 's/^/    /' >&2
  echo "    修好对应 registry 配置后重试；--no-verify 会明确绕过本地同步。" >&2
  exit 1
fi
[ -z "$sync_out" ] || echo "$sync_out" | sed 's/^/pre-commit: /'

# --- 5. 索引变化纳入提交 ---
if ! git diff --quiet -- capabilities/skills.md 2>/dev/null; then
  git add capabilities/skills.md
  echo "pre-commit: capabilities/skills.md 已自动更新并纳入本次提交"
fi
exit 0
